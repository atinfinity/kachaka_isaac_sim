<?xml version="1.0"?>
<package format="3">
  <name>kachaka_sim_bringup</name>
  <version>0.1.0</version>
  <description>SLAM, Nav2 and RViz setup for the Kachaka Isaac Sim simulator (also usable with a real Kachaka).</description>
  <maintainer email="noreply@example.com">kachaka_isaac_sim contributors</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>kachaka_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
