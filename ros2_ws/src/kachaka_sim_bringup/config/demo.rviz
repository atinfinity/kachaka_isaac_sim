# For scripts/record_demo.sh: zoomed to the default room, costmaps off.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: <Fixed Frame>
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: false
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.3
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /kachaka/robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /kachaka/lidar/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Color: 255; 64; 64
      Size (m): 0.03
      Style: Flat Squares
    - Class: rviz_default_plugins/PointCloud2
      Name: Other Robots
      Enabled: false
      Topic:
        Value: /other_robots
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Color: 255; 200; 0
      Size (m): 0.03
      Style: Flat Squares
    - Class: rviz_default_plugins/Path
      Name: Plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 64; 160; 255
    - Class: rviz_default_plugins/Polygon
      Name: Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
      Color: 0; 255; 128
    - Class: rviz_default_plugins/MarkerArray
      Name: Shelves
      Enabled: true
      Topic:
        Value: /shelf_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Movers
      Enabled: true
      Topic:
        Value: /mover_markers
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 5
    - Class: rviz_default_plugins/MarkerArray
      Name: Doors
      Enabled: true
      Topic:
        Value: /door_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: false
      Topic:
        Value: /kachaka/front_camera/image_raw
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/Image
      Name: Back camera
      Enabled: false
      Topic:
        Value: /kachaka/back_camera/image_raw
        Reliability Policy: Best Effort
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 165
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Width: 1440
  Height: 900
